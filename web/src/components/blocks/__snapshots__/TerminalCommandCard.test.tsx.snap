exports[`TerminalCommandCard > legacy output markup is byte-identical (snapshot) 1`] = `"<div data-state="closed" data-slot="collapsible" class="group not-prose w-full"><button type="button" aria-expanded="false" data-state="closed" data-slot="collapsible-trigger" class="w-full cursor-pointer"><span class="flex w-full items-center gap-1.5 py-0.5 text-left text-muted-foreground text-xs transition-colors hover:text-foreground" data-testid="terminal-command-card" data-terminal-kind="output"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-terminal size-3 shrink-0 text-emerald-500 dark:text-emerald-400" aria-hidden="true"><path d="m7 11 2-2-2-2"></path><path d="M11 13h4"></path><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect></svg><span class="min-w-0 flex-1 truncate font-mono text-muted-foreground/80">output</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right size-3 shrink-0 transition-transform group-data-[state=open]:rotate-90" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></span></button><div data-state="closed" id="radix-:r1:" hidden="" data-slot="collapsible-content" class="mt-1 ml-2 space-y-2 border-l pl-3 py-1 data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:animate-out data-[state=open]:animate-in" style=""></div></div>"`;

