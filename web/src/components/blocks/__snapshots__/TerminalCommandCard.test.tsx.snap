exports[`TerminalCommandCard — bang receipt variants > error receipt styles destructively and shows the error line (snapshot) 1`] = `"<div class="group not-prose w-full rounded-md border border-destructive/50 px-2 py-0.5" data-testid="terminal-command-card" data-terminal-kind="input" data-terminal-action="send" data-terminal-status="error"><span class="flex w-full items-center gap-1.5 py-0.5 text-left text-muted-foreground text-xs"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-terminal size-3 shrink-0 text-destructive" aria-hidden="true"><path d="m7 11 2-2-2-2"></path><path d="M11 13h4"></path><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect></svg><span class="min-w-0 flex-1 truncate font-mono"><span class="font-semibold text-foreground">$</span> echo hi</span><span data-testid="terminal-command-chip" class="shrink-0 rounded bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">→ zsh · u-ab12cd</span></span><div data-testid="terminal-command-error" class="pl-[1.125rem] text-destructive/90 text-xs">shell u-ab12cd is not running</div></div>"`;

